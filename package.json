{
  "name": "taptab-superbackend",
  "version": "2.11.0",
  "description": "TypeScript + TypeORM + PostgreSQL + Express API Server",
  "license": "ISC",
  "author": "TapTab",
  "repository": {
    "type": "git",
    "url": "https://github.com/taptabapp/super-backend.git"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc && npx tsc-alias",
    "build-dev": "env-cmd -f ./.env.development.local tsc && npx tsc-alias",
    "build-local": "env-cmd -f ./.env.localhost.local tsc && npx tsc-alias",
    "build-prod": "env-cmd -f ./.env.production.local tsc && npx tsc-alias",
    "build-stage": "env-cmd -f ./.env.staging.local tsc && npx tsc-alias",
    "dev": "cross-env NODE_ENV=development nodemon",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky install",
    "start": "cross-env NODE_ENV=development env-cmd -f ./.env node dist/server.js",
    "start-dev": "npm run build && cross-env NODE_ENV=development env-cmd -f ./.env.development.local node dist/server.js",
    "start-local": "npm run build && cross-env NODE_ENV=localhost env-cmd -f ./.env.localhost.local node dist/server.js",
    "start-prod": "npm run build && cross-env NODE_ENV=production env-cmd -f ./.env.production.local node dist/server.js",
    "start-stage": "npm run build && cross-env NODE_ENV=staging env-cmd -f ./.env.staging.local node dist/server.js",
    "test": "jest --forceExit --runInBand --detectOpenHandles --coverage --passWithNoTests --testPathPatterns=src/__tests__/unit",
    "test-controllers": "jest --forceExit --runInBand --detectOpenHandles --coverage --passWithNoTests --testPathPatterns=src/__tests__/unit/controllers",
    "test-middlewares": "jest --forceExit --runInBand --detectOpenHandles --coverage --passWithNoTests --testPathPatterns=src/__tests__/unit/middlewares",
    "test-models": "jest --forceExit --runInBand --detectOpenHandles --coverage --passWithNoTests --testPathPatterns=src/__tests__/unit/models",
    "test-services": "jest --forceExit --runInBand --detectOpenHandles --coverage --passWithNoTests --testPathPatterns=src/__tests__/unit/services",
    "test:integration": "bash Scripts/integration_tests.sh",
    "test:integration-local": "bash Scripts/integration_tests.sh local"
  },
  "dependencies": {
    "@google-cloud/logging-winston": "^5.2.2",
    "@google-cloud/storage": "^6.5.2",
    "@google-cloud/video-transcoder": "^2.3.0",
    "@sendgrid/mail": "^7.6.2",
    "@types/multer": "^1.4.7",
    "@types/pdfkit": "^0.13.1",
    "axios": "^1.13.2",
    "bcrypt": "^5.0.1",
    "class-transformer": "0.4.0",
    "class-validator": "^0.14.0",
    "compression": "^1.7.4",
    "config": "^3.3.6",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "currency-symbol-map": "^5.1.0",
    "docx": "^8.2.3",
    "dotenv": "^16.0.0",
    "env-cmd": "^10.1.0",
    "envalid": "^7.1.0",
    "express": "^4.17.1",
    "helmet": "^4.6.0",
    "hpp": "^0.2.3",
    "json-diff-ts": "^4.9.1",
    "json-stable-stringify": "^1.3.0",
    "jsonwebtoken": "^9.0.1",
    "logging-winston": "^0.0.1-security",
    "luxon": "^3.3.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.4",
    "node-geocoder": "^4.2.0",
    "openapi-types": "^12.1.0",
    "pdfkit": "^0.13.0",
    "pg": "^8.6.0",
    "pg-boss": "^12.14.0",
    "sharp": "^0.30.0",
    "stripe": "^10.10.0",
    "swagger-jsdoc": "^6.0.0",
    "swagger-ui-express": "^4.1.6",
    "ts-node": "^10.0.0",
    "typeorm": "^0.2.34",
    "uuid": "^8.3.2",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.0",
    "@types/config": "0.0.38",
    "@types/cookie-parser": "^1.4.2",
    "@types/cors": "^2.8.10",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.12",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.1",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^8.5.2",
    "@types/luxon": "^3.1.0",
    "@types/morgan": "^1.9.2",
    "@types/node": "^24.12.0",
    "@types/sharp": "^0.31.1",
    "@types/supertest": "^2.0.11",
    "@types/swagger-jsdoc": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^4.28.1",
    "@typescript-eslint/parser": "^4.28.1",
    "eslint": "^7.29.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^3.4.0",
    "get-tsconfig": "4.2.0",
    "husky": "^7.0.0",
    "jest": "^30.0.0",
    "lint-staged": "^11.0.0",
    "node-config": "0.0.2",
    "node-gyp": "^11.0.0",
    "nodemon": "^2.0.9",
    "prettier": "^2.3.2",
    "reflect-metadata": "^0.1.13",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.0.0",
    "swagger-ui-express": "^4.1.6",
    "ts-jest": "^29.4.6",
    "tsc-alias": "1.7.0",
    "tsconfig-paths": "^3.9.0",
    "typescript": "^5.7.0"
  }
}
